{
  "name": "minter-typescript-sdk",
  "version": "1.2.3",
  "description": "Minter SDK is written in TypeScript with native gRPC transport support",
  "main": "lib/index.js",
  "browser": {
    "./lib/index.js": "./lib/browser.js"
  },
  "types": "./lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/counters/minter-typescript-sdk.git"
  },
  "scripts": {
    "test": "jest",
    "build": "tsc",
    "dev": "tsc --watch",
    "prettier": "prettier --write src/* test/*",
    "tslint": "tslint -p tslint -p tsconfig.json",
    "codestyle": "npm run prettier && npm run tslint",
    "grpc": "sh bin/build_grpc.sh",
    "copy_grpc": "sh bin/copy_grpc.sh",
    "prebuild": "npm run grpc",
    "predev": "npm run grpc"
  },
  "keywords": [
    "minter",
    "blockchain",
    "sdk"
  ],
  "author": "webcounters (https://github.com/counters)",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/google-protobuf": "^3.7.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.3.0",
    "prettier": "^1.18.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "ts-proto": "^2.11.6",
    "tslint": "^5.20.0",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@grpc/grpc-js": ">=1.14.4",
    "axios": ">=1.17.0",
    "big.js": "^7.0.1",
    "google-protobuf": "^4.0.2"
  }
}
